```html
<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KritFailer</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #0e0e0e;
      color: white;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px;
      background: #1a1a1a;
    }

    .title {
      color: #ff9800;
      font-weight: bold;
    }

    .container {
      padding: 12px;
    }

    input {
      display: block;
      width: 100%;
      margin: 8px 0;
      padding: 10px;
      border: 1px solid #333;
      border-radius: 8px;
      background: #222;
      color: white;
    }

    input::placeholder {
      color: #888;
    }

    button {
      margin: 4px;
      padding: 10px;
      border: none;
      border-radius: 10px;
      background: #222;
      color: white;
      cursor: pointer;
      transition: background-color 0.2s;
    }

    button:hover {
      background: #444;
    }

    button:focus {
      outline: 2px solid #ff9800;
      outline-offset: 2px;
    }

    .active {
      background: #ff9800 !important;
    }

    .card {
      background: #1a1a1a;
      padding: 12px;
      margin-top: 8px;
      border-radius: 12px;
      border: 1px solid #333;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
    }

    .meta {
      color: #aaa;
      font-size: 12px;
    }

    .player1 { background: #ef4444; }
    .player2 { background: #22c55e; }
    .player3 { background: #3b82f6; }
    .player4 { background: #eab308; }
    .player5 { background: #a855f7; }

    .room {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #1a1a1a;
      padding: 10px;
      margin: 5px 0;
      border-radius: 10px;
    }

    #playersList {
      margin-top: 10px;
    }

    .roleplay-box {
      background: #111;
      padding: 10px;
      border-radius: 8px;
      border-left: 4px solid #ff9800;
    }

    .effect-text {
      font-size: 18px;
      margin-bottom: 10px;
    }

    .hidden {
      display: none;
    }
  </style>
</head>

<body>
  <header>
    <div class="title">🎲 KritFailer</div>
    <div id="playersTop"></div>
    <div id="topButtons"></div>
  </header>

  <div id="setup" class="container">
    <input id="name" placeholder="Jméno" autocomplete="off">
    <input id="roomName" placeholder="Název místnosti" autocomplete="off">
    <input id="roomPass" placeholder="Heslo (volitelné)" type="password" autocomplete="off">
    <button id="createRoomBtn">🎲 Vytvořit místnost</button>

    <h3>Otevřené hry</h3>
    <div id="roomsList"></div>
  </div>

  <div id="app" class="container hidden">
    <div id="dmPanel" class="hidden">
      <div id="severityButtons"></div>

      <h3>Akce</h3>
      <button data-action="melee">⚔️ Melee</button>
      <button data-action="ranged">🏹 Ranged</button>
      <button data-action="defense">🛡️ Obrana</button>

      <h3>🎲 Skilly</h3>
      <div id="skills"></div>
    </div>

    <div id="playerPanel" class="hidden">
      <h3 id="roomNameDisplay"></h3>
      <div id="playersList"></div>
      <div id="playerResult">Čekám na výsledek...</div>
    </div>
  </div>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
    import {
      getDatabase,
      ref,
      set,
      onValue,
      get,
      remove,
      onDisconnect
    } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-database.js";

    const FIREBASE_CONFIG = {
      apiKey: "AIzaSyDI3qi2zqosghoQNRQ31hDZU1y_tBioedY",
      databaseURL: "https://ktit-fail-generator-default-rtdb.europe-west1.firebasedatabase.app"
    };

    const DM_BADGE = " 👑";
    const ROLL_ANIMATION_DELAY = 400;

    const app = initializeApp(FIREBASE_CONFIG);
    const db = getDatabase(app);

    const state = {
      room: "",
      name: "",
      myId: "",
      isDM: false,
      players: {},
      data: {},
      severityList: [],
      severity: ""
    };

    const elements = {
      setup: document.getElementById("setup"),
      app: document.getElementById("app"),
      dmPanel: document.getElementById("dmPanel"),
      playerPanel: document.getElementById("playerPanel"),
      playersTop: document.getElementById("playersTop"),
      topButtons: document.getElementById("topButtons"),
      roomsList: document.getElementById("roomsList"),
      playersList: document.getElementById("playersList"),
      playerResult: document.getElementById("playerResult"),
      roomNameDisplay: document.getElementById("roomNameDisplay"),
      severityButtons: document.getElementById("severityButtons"),
      skills: document.getElementById("skills"),
      nameInput: document.getElementById("name"),
      roomNameInput: document.getElementById("roomName"),
      roomPassInput: document.getElementById("roomPass"),
      createRoomBtn: document.getElementById("createRoomBtn")
    };

    function init() {
      setupEventListeners();
      loadGameData();
      tryAutoReconnect();
      setupRoomListener();
    }

    function setupEventListeners() {
      elements.createRoomBtn.addEventListener("click", createRoom);
      elements.dmPanel.addEventListener("click", handleDmPanelClick);
      elements.severityButtons.addEventListener("click", handleSeverityClick);
      elements.roomsList.addEventListener("click", handleRoomsListClick);
    }

    function handleDmPanelClick(event) {
      const button = event.target.closest("button");
      if (!button) return;

      const action = button.dataset.action;
      if (action === "melee") {
        generateAttack("Melee", button);
      } else if (action === "ranged") {
        generateAttack("Ranged", button);
      } else if (action === "defense") {
        generateDefense(button);
      } else if (button.dataset.skillAttr && button.dataset.skillName) {
        generateSkill(button.dataset.skillAttr, button.dataset.skillName, button);
      }
    }

    function handleSeverityClick(event) {
      const button = event.target.closest("button");
      if (!button || !button.dataset.severity) return;
      setSeverity(button.dataset.severity);
    }

    function handleRoomsListClick(event) {
      const button = event.target.closest("button");
      if (!button || !button.dataset.room) return;
      joinRoom(button.dataset.room);
    }

    function tryAutoReconnect() {
      const savedRoom = localStorage.getItem("room");
      if (savedRoom) {
        state.room = savedRoom;
        state.name = localStorage.getItem("name") || "";
        state.myId = localStorage.getItem("myId") || "";
        state.isDM = localStorage.getItem("isDM") === "true";
        start();
      }
    }

    async function loadGameData() {
      try {
        const response = await fetch("crit_fails.json");
        if (!response.ok) {
          throw new Error("Failed to load game data");
        }
        state.data = await response.json();
        buildSeverity();
        buildSkills();
      } catch (error) {
        console.error("Error loading game data:", error);
      }
    }

    function buildSeverity() {
      if (!state.data.Severity) return;
      state.severityList = Object.keys(state.data.Severity);
      const html = state.severityList
        .map((sev) => `<button data-severity="${escapeHtml(sev)}">${escapeHtml(sev)}</button>`)
        .join("");
      elements.severityButtons.innerHTML = html;
    }

    function buildSkills() {
      if (!state.data.Skill) return;
      const html = Object.entries(state.data.Skill)
        .map(([attr, skills]) => {
          const skillButtons = Object.keys(skills)
            .map((skill) => `<button data-skill-attr="${escapeHtml(attr)}" data-skill-name="${escapeHtml(skill)}">${escapeHtml(skill)}</button>`)
            .join("");
          return `<div><strong>${escapeHtml(attr)}</strong><div>${skillButtons}</div></div>`;
        })
        .join("");
      elements.skills.innerHTML = html;
    }

    function setSeverity(severity) {
      state.severity = severity;
      const buttons = elements.severityButtons.querySelectorAll("button");
      buttons.forEach((btn) => {
        btn.classList.toggle("active", btn.dataset.severity === severity);
      });
    }

    function weightedRandom(pool) {
      if (!pool || pool.length === 0) return null;

      let total = 0;
      for (const item of pool) {
        total += item.weight || 1;
      }

      let random = Math.random() * total;
      for (const item of pool) {
        random -= item.weight || 1;
        if (random <= 0) return item;
      }

      return pool[0];
    }

    function escapeHtml(text) {
      const map = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;"
      };
      return String(text).replace(/[&<>"']/g, (char) => map[char]);
    }

    async function createRoom() {
      const name = elements.nameInput.value.trim();
      const roomName = elements.roomNameInput.value.trim();
      const password = elements.roomPassInput.value;

      if (!name || !roomName) {
        alert("Vyplň jméno a název místnosti");
        return;
      }

      state.name = name;
      state.room = roomName;
      state.myId = "DM_" + Date.now();
      state.isDM = true;

      try {
        await set(ref(db, "rooms/" + state.room), {
          dm: state.myId,
          password: password || null,
          players: {
            [state.myId]: { name: state.name + DM_BADGE }
          }
        });

        saveToLocalStorage();
        start();
      } catch (error) {
        console.error("Error creating room:", error);
        alert("Nepodařilo se vytvořit místnost");
      }
    }

    function saveToLocalStorage() {
      localStorage.setItem("room", state.room);
      localStorage.setItem("name", state.name);
      localStorage.setItem("myId", state.myId);
      localStorage.setItem("isDM", state.isDM);
    }

    function setupRoomListener() {
      onValue(ref(db, "rooms"), (snapshot) => {
        const rooms = snapshot.val() || {};
        renderRoomsList(rooms);
      });
    }

    function renderRoomsList(rooms) {
      const html = Object.entries(rooms)
        .map(([roomName, roomData]) => {
          const playerCount = roomData.players ? Object.keys(roomData.players).length : 0;
          return `
            <div class="room">
              <span>🎲 ${escapeHtml(roomName)} (${playerCount})</span>
              <button data-room="${escapeHtml(roomName)}">Join</button>
            </div>
          `;
        })
        .join("");

      elements.roomsList.innerHTML = html;
    }

    async function joinRoom(roomName) {
      const name = elements.nameInput.value.trim();
      if (!name) {
        alert("Zadej jméno");
        return;
      }

      try {
        const snapshot = await get(ref(db, "rooms/" + roomName));
        const roomData = snapshot.val();

        if (!roomData) {
          alert("Místnost neexistuje");
          return;
        }

        if (roomData.password) {
          const enteredPassword = prompt("Zadej heslo:");
          if (enteredPassword !== roomData.password) {
            alert("Špatné heslo");
            return;
          }
        }

        state.room = roomName;
        state.name = name;
        state.myId = localStorage.getItem("myId") || "P_" + Date.now();
        state.isDM = false;

        await set(ref(db, "rooms/" + state.room + "/players/" + state.myId), { name: state.name });

        saveToLocalStorage();
        start();
      } catch (error) {
        console.error("Error joining room:", error);
        alert("Nepodařilo se připojit k místnosti");
      }
    }

    function start() {
      elements.setup.classList.add("hidden");
      elements.app.classList.remove("hidden");

      if (state.isDM) {
        elements.dmPanel.classList.remove("hidden");
        elements.topButtons.innerHTML = `
          <button id="deleteRoomBtn">🗑️</button>
          <button id="logoutBtn">Logout</button>
        `;
      } else {
        elements.playerPanel.classList.remove("hidden");
        elements.roomNameDisplay.textContent = "Room: " + state.room;
        elements.topButtons.innerHTML = `
          <button id="logoutBtn">Logout</button>
        `;
      }

      setupTopButtonListeners();
      setupDisconnectHandlers();
      setupPlayersListener();
      listenMessages();
    }

    function setupTopButtonListeners() {
      const deleteBtn = document.getElementById("deleteRoomBtn");
      const logoutBtn = document.getElementById("logoutBtn");

      if (deleteBtn) {
        deleteBtn.addEventListener("click", deleteRoom);